{
  "manifest_version": 3,
  "name": "VidsSave — Video Downloader",
  "version": "1.0.0",
  "description": "Download the video on the current tab with VidsSave. Right-click a page or link, or use the popup.",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Download with VidsSave",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
